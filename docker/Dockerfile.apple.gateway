# OneCLI Gateway — Apple native container variant
# Uses alpine instead of Chainguard wolfi-base (which segfaults in Apple's VM).
#
# Usage:
#   container build -t onecli-gw -f docker/Dockerfile.apple.gateway .

# ──────────────────────────────────────────────
# Stage 1a: Install cargo-chef
# ──────────────────────────────────────────────
FROM rust:1-alpine AS chef
RUN apk add --no-cache musl-dev pkgconfig openssl-dev openssl-libs-static && \
    cargo install cargo-chef
WORKDIR /build

# ──────────────────────────────────────────────
# Stage 1b: Prepare dependency recipe
# ──────────────────────────────────────────────
FROM chef AS planner
COPY apps/gateway/ .
RUN cargo chef prepare --recipe-path recipe.json

# ──────────────────────────────────────────────
# Stage 1c: Build Rust gateway
# ──────────────────────────────────────────────
FROM chef AS builder
COPY --from=planner /build/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY apps/gateway/ .
RUN cargo build --release

# ──────────────────────────────────────────────
# Stage 2: Minimal runtime (Alpine-based)
# ──────────────────────────────────────────────
FROM docker.io/alpine:latest AS runner

# Create nonroot user (matching Chainguard UID 65532)
RUN addgroup -g 65532 -S nonroot && \
    adduser -u 65532 -S nonroot -G nonroot

# wget for healthcheck
RUN apk update && apk add --no-cache wget bash && rm -rf /var/cache/apk/*

COPY --from=builder /build/target/release/onecli-gateway /usr/local/bin/onecli-gateway

# Entrypoint wrapper
COPY docker/entrypoint-gateway.sh /usr/local/bin/entrypoint-gateway.sh
RUN chmod +x /usr/local/bin/entrypoint-gateway.sh

RUN mkdir -p /app/data && chown nonroot:nonroot /app/data
VOLUME ["/app/data"]

USER nonroot
EXPOSE 10255

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:10255/healthz || exit 1

ENTRYPOINT ["entrypoint-gateway.sh"]
CMD ["--port", "10255", "--data-dir", "/app/data"]
